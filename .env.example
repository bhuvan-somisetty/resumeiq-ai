# ─────────────────────────────────────────────────────────────
# ResumeIQ AI — Environment Variables
# Copy this file to `.env.local` for local development and fill in real values.
# Never commit real secrets. See /docs/02-System-Architecture.md §2.10.
# ─────────────────────────────────────────────────────────────

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
NODE_ENV=development

# Database (PostgreSQL + pgvector) — see /docs/03-Database-Schema.md
# Local docker: postgresql://resumeiq:resumeiq@localhost:5432/resumeiq?schema=public
# Neon (production): use the POOLED connection string (host contains "-pooler")
#   for DATABASE_URL, and the DIRECT (non-pooled) string for DIRECT_URL.
#   Append ?sslmode=require to both.
DATABASE_URL="postgresql://resumeiq:resumeiq@localhost:5432/resumeiq?schema=public"
# Direct connection used only by `prisma migrate`. Locally, set it equal to
# DATABASE_URL. On Neon, use the non-pooled host.
DIRECT_URL="postgresql://resumeiq:resumeiq@localhost:5432/resumeiq?schema=public"

# Clerk Authentication — https://dashboard.clerk.com
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
CLERK_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
CLERK_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/app
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/app

# Google Gemini (free tier) — https://aistudio.google.com/apikey
# AI analysis runs on Gemini; no billing required for the free tier.
GEMINI_API_KEY=AIzaxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Optional model overrides (defaults shown):
GEMINI_ANALYSIS_MODEL=gemini-2.0-flash
GEMINI_FAST_MODEL=gemini-2.0-flash

# UploadThing — https://uploadthing.com/dashboard
UPLOADTHING_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Inngest — https://app.inngest.com
INNGEST_EVENT_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
INNGEST_SIGNING_KEY=signkey-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Observability (optional in dev)
SENTRY_DSN=
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
